@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="graffiti-hero video-hero">
  <video class="bg-video" autoplay muted loop playsinline poster="@Poster" id="@VideoId">
    <source src="@VideoWebm" type="video/webm" />
    <source src="@VideoMp4" type="video/mp4" />
  </video>

  <div class="tag">
    <div class="title">@Title</div>
    <div class="subtitle">@Subtitle</div>
  </div>
</div>

@code {
  [Parameter] public string Title { get; set; } = "Your Name";
  [Parameter] public string Subtitle { get; set; } = "Portfolio";
  [Parameter] public string VideoWebm { get; set; } = "/videos/graffiti-loop.webm";
  [Parameter] public string VideoMp4 { get; set; } = "/videos/graffiti-loop.mp4";
  [Parameter] public string Poster { get; set; } = "/images/graffiti-poster.jpg";
  private string VideoId = $"video_{Guid.NewGuid():N}";
}
